APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CDN/host estático que serve o conteúdo de storage/app/public na raiz.
# Ex.: https://cdn.snrfit.com.br . Quando definido, vídeos e imagens são
# entregues por ele (sem passar pelo PHP) — essencial para escala. Ver SCALE.md.
# Vazio = servir pela própria API (bom para desenvolvimento).
MEDIA_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academia
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─────────────────────────────────────────────────────────────────────────────
# ENDURECIMENTO PARA PRODUÇÃO (A02/A05/A07)
# Os valores acima são de DESENVOLVIMENTO. Em produção, defina:
#
#   APP_ENV=production       <- COMECE POR ESTE. É a chave que liga quase todo
#                               o endurecimento do código: AppServiceProvider
#                               só desliga o debug à força, só força HTTPS nos
#                               links e só desarma o Ignition quando o ambiente
#                               é `production`. Em 09/10/2026 o servidor estava
#                               rodando com outro valor aqui, e por isso um
#                               simples 404 em snrfit.com.br devolvia stack
#                               trace com o caminho absoluto do servidor.
#   APP_DEBUG=false          <- crítico: com true, a tela de erro expõe trecho
#                               de código, variáveis e valores do .env a
#                               qualquer visitante que provoque uma exceção
#                               (DB_PASSWORD, ASAAS_*, TWILIO_AUTH_TOKEN,
#                               APP_KEY). Hoje existe uma segunda trava que
#                               desliga o debug quando o HOST é público, mesmo
#                               com APP_ENV errado — mas ela é a rede de
#                               segurança, não a configuração. Defina os dois.
#                               Desligar não atrapalha investigar nada: o stack
#                               trace completo continua em storage/logs.
#   SESSION_SECURE_COOKIE=true   <- cookie de sessão só por HTTPS; sem isso ele
#                                   trafega em claro se alguém acessar por HTTP.
#   SESSION_ENCRYPT=true         <- cifra o conteúdo da sessão em repouso
#                                   (driver `file` grava em disco no servidor).
#   SESSION_SAME_SITE=lax        <- mantém `lax`; `none` exigiria secure e abre CSRF.
#   CORS_ALLOWED_ORIGINS=https://snrfit.com.br,https://www.snrfit.com.br
#                                <- sem esta env o padrão é '*', que libera
#                                   chamada cross-origin de qualquer site.
#   IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false  <- já é o padrão; não ligue. Essas
#                                   rotas executam ação no servidor pelo browser
#                                   (origem do CVE-2021-3129, RCE).
#
# Descomente ao publicar:
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# CORS_ALLOWED_ORIGINS=https://snrfit.com.br
# ─────────────────────────────────────────────────────────────────────────────

# Content-Security-Policy (config/csp.php).
# ESTREIE COM CSP_REPORT_ONLY=true: o navegador apenas RELATA as violações em
# POST /csp-report (canal `security` do log) sem bloquear nada. Acompanhe
# storage/logs/security-*.log procurando "csp_violacao" por um ou dois dias,
# libere o que aparecer de legítimo e só então mude para false.
# CSP_ENABLED=false desliga o header sem precisar de deploy de código.
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# Hosts extra, separados por vírgula, se você adicionar algum serviço novo:
# CSP_EXTRA_SCRIPT=
# CSP_EXTRA_STYLE=
# CSP_EXTRA_IMG=
# CSP_EXTRA_CONNECT=
# CSP_EXTRA_FONT=
# CSP_EXTRA_MEDIA=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Meta (Facebook) Pixel + API de Conversões (server-side).
# META_CAPI_TOKEN: gerado no Events Manager > Configurações > API de Conversões.
# Sem o token, só o Pixel do browser funciona (a CAPI vira no-op).
META_PIXEL_ID=28125781433700453
META_CAPI_TOKEN=
META_API_VERSION=v21.0
# Código do "Testar eventos" (Events Manager) para depurar; vazio em produção.
META_CAPI_TEST_CODE=
# LGPD: quando true, Pixel e CAPI só disparam após o aceite no banner de cookies.
META_REQUIRE_CONSENT=true

# Programa de indicação ("Indique e ganhe") — revenue share.
# Quem indica recebe INDICACAO_PERCENTUAL do faturamento BRUTO do indicado durante
# INDICACAO_JANELA_DIAS contados da aprovação dele. O valor só pode ser sacado
# depois que a janela fecha E o indicado tem INDICACAO_META_ALUNOS alunos pagantes.
# Todos têm default no config; defina aqui só para mudar a regra.
INDICACAO_PERCENTUAL=0.10
INDICACAO_JANELA_DIAS=35
INDICACAO_META_ALUNOS=6
INDICACAO_SAQUE_MINIMO=20.00

# Pix AUTOMÁTICO do bônus (Asaas /transfers na conta da plataforma).
# ATENÇÃO: com `true`, dinheiro REAL sai da conta sem passar por ninguém.
# Deixe `false` até ter testado em sandbox. Os dois tetos são o limite de estrago:
# nenhum pedido acima do teto é automatizado (vai para a fila do admin), e a soma
# dos automáticos do dia não passa do teto diário.
# Requer ASAAS_WEBHOOK_TOKEN configurado: sem ele o webhook de validação de saque
# recusa tudo (fail-closed) e nenhuma transferência é liberada.
INDICACAO_SAQUE_AUTO=false
INDICACAO_SAQUE_AUTO_TETO=300.00
INDICACAO_SAQUE_AUTO_TETO_DIARIO=2000.00

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
